# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV=sandbox
# Set to your tunnel URL during dev (must match what's registered in Shopee Console)
SHOPEE_REDIRECT_URL=https://your-tunnel.loca.lt/api/shopee/callback

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Token encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=

# AI for chat reply suggestions (optional). LLM_PROVIDER picks which key is used: claude | openai | deepseek
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Leave empty for the provider default (claude-haiku-4-5-20251001 / gpt-4o-mini / deepseek-chat)
LLM_MODEL=

# Overview "low stock" list: items at or below this many units (default 5)
LOW_STOCK_THRESHOLD=5

# DEV ONLY: serve seeded buyer chats instead of Shopee's (the sandbox can't create buyer conversations).
# Never set in production.
MOCK_CHAT=

# App password lock. Leave EMPTY for local dev (no lock).
# Set a password on the Railway api service to require login before anyone can use the live app.
APP_PASSWORD=

# WhatsApp (optional). Numbers link by QR code through the always-on worker (worker/, its own
# Railway service). Set both on the Railway api service AND on the worker, same secret.
WA_WORKER_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WA_WORKER_SECRET=
