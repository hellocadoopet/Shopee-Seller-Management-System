{
  "name": "shopee-solo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.13.8",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0"
  }
}
